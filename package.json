{
  "name": "multicursor",
  "private": true,
  "version": "0.1.0",
  "description": "Drop-in real-time multi-user cursor library",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "build": "pnpm -r build",
    "cursors": "multicursor-server --port 3001",
    "dev:server": "pnpm --filter @multicursor/server dev",
    "clean": "pnpm -r clean"
  }
}
